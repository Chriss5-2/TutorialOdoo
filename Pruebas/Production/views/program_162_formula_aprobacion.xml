<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <!-- SEQUENCE -->
        <record id="seq_formula_solicitud" model="ir.sequence">
            <field name="name">Solicitud de Formula</field>
            <field name="code">bm.Formula.solicitud</field>
            <field name="prefix">AFOR/</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>

        <!-- SOLICITUD TREE VIEW -->
        <record id="view_formula_solicitud_tree" model="ir.ui.view">
            <field name="name">bm.ctl.produccion.formula.solicitud.tree</field>
            <field name="model">bm.ctl.produccion.formula.solicitud</field>
            <field name="arch" type="xml">
                <tree string="Solicitudes de Formula" decoration-info="state == 'draft'" decoration-warning="state == 'pending'" decoration-success="state == 'approved'" decoration-danger="state in ('rejected', 'cancelled')">
                    <field name="name"/>
                    <field name="fecha"/>
                    <field name="solicitante"/>
                    <field name="qarticulos"/>
                    <field name="qacciones"/>
                    <field name="stsaprobac"/>
                    <field name="state"/>
                </tree>
            </field>
        </record>

        <!-- SOLICITUD FORM VIEW -->
        <record id="view_formula_solicitud_form" model="ir.ui.view">
            <field name="name">bm.ctl.produccion.formula.solicitud.form</field>
            <field name="model">bm.ctl.produccion.formula.solicitud</field>
            <field name="arch" type="xml">
                <form string="Solicitud de Formula">
                    <header>
                        <button name="action_submit" string="Enviar a Aprobacion" type="object" class="oe_highlight" states="draft"/>
                        <button name="action_approve" string="Aprobar" type="object" class="oe_highlight" states="pending"/>
                        <button name="action_reject" string="Rechazar" type="object" states="pending"/>
                        <button name="action_cancel" string="Cancelar" type="object" states="draft,pending"/>
                        <button name="action_reset_to_draft" string="Reiniciar a Borrador" type="object" states="rejected,cancelled"/>
                        <field name="state" widget="statusbar" statusbar_visible="draft,pending,approved"/>
                    </header>
                    <sheet>
                        <div class="oe_title">
                            <h1>
                                <field name="name" readonly="1"/>
                            </h1>
                        </div>
                        <group>
                            <group string="Informacion General">
                                <field name="compania"/>
                                <field name="transaccio"/>
                                <field name="fecha"/>
                                <field name="solicitante"/>
                                <field name="nivelapr"/>
                                <field name="aprobador"/>
                            </group>
                            <group string="Status">
                                <field name="stsaprobac"/>
                                <field name="fecaprobac" readonly="1"/>
                                <field name="horaprobac" readonly="1"/>
                                <field name="stsactualiza"/>
                                <field name="flganulado"/>
                                <field name="fecanula" readonly="1"/>
                            </group>
                            <group string="Auditoria">
                                <field name="feccrea" readonly="1"/>
                                <field name="horcrea" readonly="1"/>
                                <field name="usucrea" readonly="1"/>
                                <field name="fecultmod" readonly="1"/>
                                <field name="horultmod" readonly="1"/>
                                <field name="ultusumod" readonly="1"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Lineas de Formula" name="lineas">
                                <field name="line_ids">
                                    <tree string="Lineas" editable="bottom">
                                        <field name="sucform"/>
                                        <field name="articulo"/>
                                        <field name="insumo"/>
                                        <field name="linea"/>
                                        <field name="factconv"/>
                                        <field name="accion"/>
                                        <field name="nivapro"/>
                                        <field name="flgaprob"/>
                                        <field name="stssolicitud"/>
                                    </tree>
                                </field>
                            </page>
                            <page string="Firmas de Aprobacion" name="firmas">
                                <field name="firma_ids" readonly="1">
                                    <tree string="Firmas">
                                        <field name="nivel"/>
                                        <field name="empleautor"/>
                                        <field name="fecautoriz"/>
                                        <field name="horautoriz"/>
                                        <field name="stsaprobac"/>
                                        <field name="observac"/>
                                    </tree>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- SOLICITUD SEARCH VIEW -->
        <record id="view_formula_solicitud_search" model="ir.ui.view">
            <field name="name">bm.ctl.produccion.formula.solicitud.search</field>
            <field name="model">bm.ctl.produccion.formula.solicitud</field>
            <field name="arch" type="xml">
                <search string="Buscar Solicitudes">
                    <field name="name"/>
                    <field name="solicitante"/>
                    <field name="compania"/>
                    <field name="transaccio"/>
                    <filter name="draft" string="Borrador" domain="[('state', '=', 'draft')]"/>
                    <filter name="pending" string="En Aprobacion" domain="[('state', '=', 'pending')]"/>
                    <filter name="approved" string="Aprobado" domain="[('state', '=', 'approved')]"/>
                    <filter name="rejected" string="Rechazado" domain="[('state', '=', 'rejected')]"/>
                    <group expand="0" string="Agrupar por">
                        <filter name="group_state" string="Estado" context="{'group_by': 'state'}"/>
                        <filter name="group_stsaprobac" string="Status Aprobacion" context="{'group_by': 'stsaprobac'}"/>
                    </group>
                </search>
            </field>
        </record>

        <!-- ACTION -->
        <record id="action_formula_solicitud" model="ir.actions.act_window">
            <field name="name">Aprobacion de Formulas</field>
            <field name="res_model">bm.ctl.produccion.formula.solicitud</field>
            <field name="view_mode">tree,form</field>
            <field name="search_view_id" ref="view_formula_solicitud_search"/>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Crea tu primera solicitud de aprobacion de formula
                </p>
                <p>
                    Gestiona el flujo de aprobacion de formulas de fabricacion con multiples niveles.
                </p>
            </field>
        </record>

        <!-- APROBADOR CONFIG TREE VIEW -->
        <record id="view_formula_aprobador_config_tree" model="ir.ui.view">
            <field name="name">bm.ctl.produccion.formula.aprobador.config.tree</field>
            <field name="model">bm.ctl.produccion.formula.aprobador.config</field>
            <field name="arch" type="xml">
                <tree string="Configuracion de Aprobadores" editable="bottom">
                    <field name="compania"/>
                    <field name="transaccio"/>
                    <field name="nivel"/>
                    <field name="tipaprob"/>
                    <field name="aprobador"/>
                    <field name="estado"/>
                </tree>
            </field>
        </record>

        <!-- APROBADOR CONFIG ACTION -->
        <record id="action_formula_aprobador_config" model="ir.actions.act_window">
            <field name="name">Configuracion de Aprobadores</field>
            <field name="res_model">bm.ctl.produccion.formula.aprobador.config</field>
            <field name="view_mode">tree,form</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Configura los aprobadores por nivel
                </p>
                <p>
                    Define quien puede aprobar en cada nivel del flujo de aprobacion.
                </p>
            </field>
        </record>

        <!-- FIRMA TREE VIEW -->
        <record id="view_formula_firma_tree" model="ir.ui.view">
            <field name="name">bm.ctl.produccion.formula.firma.tree</field>
            <field name="model">bm.ctl.produccion.formula.firma</field>
            <field name="arch" type="xml">
                <tree string="Firmas de Aprobacion">
                    <field name="nrodoc"/>
                    <field name="nivel"/>
                    <field name="empleautor"/>
                    <field name="fecautoriz"/>
                    <field name="horautoriz"/>
                    <field name="stsaprobac"/>
                    <field name="observac"/>
                </tree>
            </field>
        </record>

        <!-- FIRMA ACTION -->
        <record id="action_formula_firma" model="ir.actions.act_window">
            <field name="name">Historial de Firmas</field>
            <field name="res_model">bm.ctl.produccion.formula.firma</field>
            <field name="view_mode">tree,form</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    No hay firmas registradas
                </p>
                <p>
                    Historial completo de aprobaciones y rechazos de formulas.
                </p>
            </field>
        </record>

        <!-- MENU ITEMS -->
        <menuitem id="menu_formula_root"
                  name="Formulas"
                  parent="production_menu_root"
                  sequence="10"/>

        <menuitem id="menu_formula_aprobacion"
                  name="Aprobacion de Formulas"
                  parent="menu_formula_root"
                  action="action_formula_solicitud"
                  sequence="10"/>

        <menuitem id="menu_formula_config"
                  name="Configuracion"
                  parent="menu_formula_root"
                  sequence="20"/>

        <menuitem id="menu_formula_aprobador_config"
                  name="Aprobadores"
                  parent="menu_formula_config"
                  action="action_formula_aprobador_config"
                  sequence="10"/>

        <menuitem id="menu_formula_firmas"
                  name="Historial de Firmas"
                  parent="menu_formula_config"
                  action="action_formula_firma"
                  sequence="20"/>
    </data>
</odoo>
