        </record>
        <record id="proceso_empacado" model="bm.ctl.produccion.proceso">
            <field name="codigo">EMP</field>
            <field name="descripcion">Empacado</field>
            <field name="secuencia">60</field>
            <field name="categoria_linea_id" ref="categoria_021"/>
            <field name="activo" eval="True"/>
        </record>
    </data>
</odoo>
